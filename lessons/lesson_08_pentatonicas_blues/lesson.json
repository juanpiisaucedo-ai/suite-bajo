    },
    {
      "question": "La pentatónica mayor de Do usa la misma caja que…",
      "options": [
        "La pentatónica menor de La",
        "La pentatónica menor de Sol",
        "Ninguna otra"
      ],
      "answer": 0,
      "explain": "Relativas (L6): mismas notas, otro hogar. Am pent = C pent mayor."
    },
    {
      "question": "¿Qué nota convierte la pentatónica menor en escala de blues?",
      "options": [
        "La 2ª mayor",
        "La b5 (blue note)",
        "La 7ª mayor"
      ],
      "answer": 1,
      "explain": "El tritono como nota de PASO entre la 4 y la 5."
    },
    {
      "question": "En un blues de 12 en La, ¿qué acorde va en el compás 9?",
      "options": [
        "A7 (I)",
        "D7 (IV)",
        "E7 (V)"
      ],
      "answer": 2,
      "explain": "La recta final: 9=V, 10=IV, 11=I, 12=V (turnaround)."
    },
    {
      "question": "¿Cómo se usa bien la blue note?",
      "options": [
        "Como reposo final",
        "Como nota de paso cromática entre 4 y 5",
        "Como fundamental"
      ],
      "answer": 1,
      "explain": "Pasa por ella (4–b5–5); no te estaciones."
    }
  ],
